# Copiar a .env y completar. .env NUNCA se sube al repo.

# --- Supabase (frontend: son públicas por diseño, la seguridad la da RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (solo scripts locales: seed, importador, tests). SECRETO ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Pareja (lo usa el script de seed; no se hardcodea en el código) ---
PAREJA_NOMBRE=
MIEMBRO_1_NOMBRE=
MIEMBRO_1_EMAIL=
MIEMBRO_2_NOMBRE=
MIEMBRO_2_EMAIL=

# --- Splitwise (hito 5, solo lectura). SECRETO ---
SPLITWISE_API_KEY=
SPLITWISE_GROUP_ID=

# --- Mail diario (hito 6; en producción va en GitHub Secrets). SECRETO ---
BREVO_API_KEY=
MAIL_REMITENTE=
